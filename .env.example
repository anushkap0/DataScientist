# --- Reporting service: choose ONE provider ---
REPORT_LLM_PROVIDER=huggingface


# huggingface (set REPORT_LLM_PROVIDER=huggingface to use these instead):
HF_API_TOKEN=hf_your-token-here
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# --- Feature engineering: free-text column embeddings (no token needed, public model) ---
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TEXT_EMBEDDING_COMPONENTS=16
